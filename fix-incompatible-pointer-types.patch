Description: Fix frontend UTF-8 ID3 helpers for LAME 4.0 API
 In 4.0, id3tag_set_textinfo_utf8 / id3tag_set_comment_utf8 take char const*
 (not unsigned short*). The frontend still treated TENC_UTF8 like UCS-2,
 which breaks the build with -Wincompatible-pointer-types.

--- a/frontend/parse.c
+++ b/frontend/parse.c
@@ -402,35 +402,42 @@
 }
 
 #ifdef ID3TAGS_EXTENDED
+/* LAME 4.0: UTF-8 ID3 helpers take char const*; UTF-16 still uses unsigned short. */
 static int
-set_id3v2tag(lame_global_flags* gfp, TextEncoding enc, int type, unsigned short const* str)
+set_id3v2tag(lame_global_flags* gfp, TextEncoding enc, int type, void const* str)
 {
     switch (enc)
     {
         case TENC_UTF8:
-            switch (type)
             {
-                case 'a': return id3tag_set_textinfo_utf8(gfp, "TPE1", str);
-                case 't': return id3tag_set_textinfo_utf8(gfp, "TIT2", str);
-                case 'l': return id3tag_set_textinfo_utf8(gfp, "TALB", str);
-                case 'g': return id3tag_set_textinfo_utf8(gfp, "TCON", str);
-                case 'c': return id3tag_set_comment_ucs2(gfp, 0, 0, str);
-                case 'n': return id3tag_set_textinfo_utf8(gfp, "TRCK", str);
-                case 'y': return id3tag_set_textinfo_utf8(gfp, "TYER", str);
-                case 'v': return id3tag_set_fieldvalue_ucs2(gfp, str);
+                char const* u8 = (char const*) str;
+                switch (type)
+                {
+                    case 'a': return id3tag_set_textinfo_utf8(gfp, "TPE1", u8);
+                    case 't': return id3tag_set_textinfo_utf8(gfp, "TIT2", u8);
+                    case 'l': return id3tag_set_textinfo_utf8(gfp, "TALB", u8);
+                    case 'g': return id3tag_set_textinfo_utf8(gfp, "TCON", u8);
+                    case 'c': return id3tag_set_comment_utf8(gfp, 0, 0, u8);
+                    case 'n': return id3tag_set_textinfo_utf8(gfp, "TRCK", u8);
+                    case 'y': return id3tag_set_textinfo_utf8(gfp, "TYER", u8);
+                    case 'v': return id3tag_set_fieldvalue(gfp, u8);
+                }
             }
             ;;
         case TENC_UTF16:
-            switch (type)
             {
-                case 'a': return id3tag_set_textinfo_utf16(gfp, "TPE1", str);
-                case 't': return id3tag_set_textinfo_utf16(gfp, "TIT2", str);
-                case 'l': return id3tag_set_textinfo_utf16(gfp, "TALB", str);
-                case 'g': return id3tag_set_textinfo_utf16(gfp, "TCON", str);
-                case 'c': return id3tag_set_comment_utf16(gfp, 0, 0, str);
-                case 'n': return id3tag_set_textinfo_utf16(gfp, "TRCK", str);
-                case 'y': return id3tag_set_textinfo_utf16(gfp, "TYER", str);
-                case 'v': return id3tag_set_fieldvalue_utf16(gfp, str);
+                unsigned short const* u16 = (unsigned short const*) str;
+                switch (type)
+                {
+                    case 'a': return id3tag_set_textinfo_utf16(gfp, "TPE1", u16);
+                    case 't': return id3tag_set_textinfo_utf16(gfp, "TIT2", u16);
+                    case 'l': return id3tag_set_textinfo_utf16(gfp, "TALB", u16);
+                    case 'g': return id3tag_set_textinfo_utf16(gfp, "TCON", u16);
+                    case 'c': return id3tag_set_comment_utf16(gfp, 0, 0, u16);
+                    case 'n': return id3tag_set_textinfo_utf16(gfp, "TRCK", u16);
+                    case 'y': return id3tag_set_textinfo_utf16(gfp, "TYER", u16);
+                    case 'v': return id3tag_set_fieldvalue_utf16(gfp, u16);
+                }
             }
             ;;
         default:
